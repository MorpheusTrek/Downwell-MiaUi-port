@@ -207,12 +209,38 @@ void GLCommon_beginGUI(
     int32_t guiW, int32_t guiH, int32_t portX, int32_t portY, int32_t portW, int32_t portH
 ) {
     GLRenderer* gl = (GLRenderer*) renderer;
+    float virtualW = (float) guiW;
+    float virtualH = (float) guiH;
     if (targetSurfaceId == RENDER_TARGET_HOST_FRAMEBUFFER) {
         glBindFramebuffer(GL_FRAMEBUFFER, hostFramebuffer);
-        int32_t sx, sy, ex, ey;
-        GLCommon_computeLetterbox(guiW, guiH, portW, portH, &sx, &sy, &ex, &ey);
-        glViewport(sx, sy, ex - sx, ey - sy);
-        glScissor(sx, sy, ex - sx, ey - sy);
+        if (g_guiAspect > 0.0f) {
+            // Downwell fix: draw the GUI across the full port at the requested aspect ratio
+            // instead of letterboxing it to the game's narrow GUI size. The game's HUD is
+            // laid out outside the 160x284 GUI rect, so it must not be scissored away.
+            int32_t effW, effH;
+            if ((float) portW / (float) portH > g_guiAspect) {
+                effH = portH;
+                effW = (int32_t) ((float) portH * g_guiAspect);
+            } else {
+                effW = portW;
+                effH = (int32_t) ((float) portW / g_guiAspect);
+            }
+            int32_t sx = portX + (portW - effW) / 2;
+            int32_t sy = portY + (portH - effH) / 2;
+            glViewport(sx, sy, effW, effH);
+            glScissor(sx, sy, effW, effH);
+            virtualH = (float) guiH;
+            virtualW = virtualH * g_guiAspect;
+            if (virtualW < (float) guiW) {
+                virtualW = (float) guiW;
+                virtualH = virtualW / g_guiAspect;
+            }
+        } else {
+            int32_t sx, sy, ex, ey;
+            GLCommon_computeLetterbox(guiW, guiH, portW, portH, &sx, &sy, &ex, &ey);
+            glViewport(sx, sy, ex - sx, ey - sy);
+            glScissor(sx, sy, ex - sx, ey - sy);
+        }
     } else {
         require(targetSurfaceId >= 0 && (uint32_t) targetSurfaceId < gl->surfaceCount);
         require(gl->surfaces[targetSurfaceId] != 0);
@@ -237,7 +265,7 @@ void GLCommon_beginGUI(
     camera->viewAngle = 0;
 
     Matrix4f projectionMatrix;
-    Matrix4f_Orthographic(&projectionMatrix, (float) guiW, (float) guiH, 32000.0, 0.0);
+    Matrix4f_Orthographic(&projectionMatrix, virtualW, virtualH, 32000.0, 0.0);
 
     Matrix4f viewMatrix;
     float x = (float) guiW * 0.5f;
